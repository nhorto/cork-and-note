{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": {}
    },
    "production-internal": {
      "distribution": "internal",
      "channel": "production"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "image": "latest"
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "environment": "development"
    },
    "simulator": {
      "distribution": "internal",
      "environment": "preview",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_SCREENSHOT_MODE": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6780661381"
      },
      "android": {
        "serviceAccountKeyPath": "/Users/nicholashorton/.private_keys/play-publisher.json",
        "track": "internal"
      }
    }
  }
}