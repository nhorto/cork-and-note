{
  "expo": {
    "name": "Cork & Note",
    "slug": "cork-and-note",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "corkandnote",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nicholashorton.corkandnote",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Cork & Note uses the camera to take photos of wines and wineries.",
        "NSLocationWhenInUseUsageDescription": "Cork & Note uses your location to find nearby wineries and log visit locations.",
        "NSPhotoLibraryUsageDescription": "Cork & Note accesses your photo library to save and select wine photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#54258A"
      },
      "package": "com.nicholashorton.corkandnote",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FAF8F4",
          "dark": {
            "backgroundColor": "#191321",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-camera",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-image-picker",
      "expo-location",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Cork & Note saves your wine photos to your photo library."
        }
      ],
      "./plugins/withFmtConstevalFix",
      "./plugins/withPredictiveBackOptOut",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "url": "https://u.expo.dev/3338eff4-c93e-49be-b32c-e802c16d122c"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3338eff4-c93e-49be-b32c-e802c16d122c"
      }
    },
    "backgroundColor": "#FAF8F4"
  }
}
